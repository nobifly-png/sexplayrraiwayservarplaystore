# Server
# On Render: NODE_ENV=production, PORT is set automatically (do not override)
NODE_ENV=production
PORT=5000
APP_URL=https://your-render-service.onrender.com
LOG_LEVEL=info

# Database - REQUIRED: Replace with your MongoDB connection string
# Local: mongodb://localhost:27017/zexgram
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/zexgram
MONGODB_URI=mongodb://localhost:27017/zexgram

# JWT - REQUIRED: Replace with long random values
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-strong-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Super admin seed (required for `npm run seed:admin`)
# Email must be in allowlist: canonical accounts (see docs/BACKEND_DEPLOYMENT.md) or SUPER_ADMIN_ALLOWLIST below.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@zexgram.local
# Comma-separated extra emails allowed as SUPER_ADMIN (e.g. include admin@zexgram.local for local seed)
SUPER_ADMIN_ALLOWLIST=admin@zexgram.local
SUPER_ADMIN_PASSWORD=replace-with-strong-admin-password

# Cloudflare R2 - OPTIONAL for startup, REQUIRED for upload endpoints
# Get these from Cloudflare R2 dashboard
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://your-public-bucket-domain
R2_REGION=auto

# CORS - Set to your frontend domain (REQUIRED in production)
CORS_ORIGIN=https://your-frontend-domain.com

# Frontend URL - REQUIRED for password reset emails
# This is used to generate the reset password link in emails
# Development: http://localhost:5173
# Production: https://zaxgram.com
FRONTEND_URL=https://zaxgram.com

# Reverse proxy: number of trusted hops in front of Node (0/false = direct connection; 1 = typical single proxy).
# REQUIRED on Render (and any reverse-proxy host): set to 1
# See docs/BACKEND_DEPLOYMENT.md
TRUST_PROXY=1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Auth routes (/api/auth/*): max requests per 15 minutes per IP (default 60 in dev, 5 in production)
# AUTH_RATE_LIMIT_MAX=60
# Admin routes (/api/admin, /api/settings, /api/fraud, super-admin withdrawal actions): per 15 min per IP
# ADMIN_RATE_LIMIT_MAX=120
# POST /api/withdrawals: per 15 min per IP
# WITHDRAWAL_RATE_LIMIT_MAX=40

# Telegram Bot (Optional - disabled by default)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=false

# Telegram Local Bot API (Optional - for files > 20MB up to 2GB)
# Standard Telegram Bot API: 20MB limit ❌
# Local Bot API Server: 2GB limit ✅
# 
# IMPORTANT: The backend now uses STREAMING to upload large files directly to R2.
# Memory usage remains bounded regardless of file size (100MB, 500MB, or 1GB videos).
#
# Railway Setup:
# 1. Deploy telegram-bot-api service with Docker image: aiogram/telegram-bot-api:latest
# 2. Set environment variables on telegram-bot-api service:
#    TELEGRAM_API_ID=your_api_id (from https://my.telegram.org/apps)
#    TELEGRAM_API_HASH=your_api_hash (from https://my.telegram.org/apps)
#    TELEGRAM_LOCAL=1
# 3. Add Railway Volume to telegram-bot-api service:
#    Mount Path: /var/lib/telegram-bot-api
#    Size: 5GB minimum (for temporary file storage)
# 4. Configure backend environment variables below:
#
# Enable Local Bot API:
TELEGRAM_USE_LOCAL_API=false
#
# Railway Internal URL (RECOMMENDED - uses private networking):
# Use Railway's service reference variable: http://telegram-bot-api.railway.internal:8081
TELEGRAM_LOCAL_API_INTERNAL_URL=
#
# Public URL (FALLBACK - used if internal URL not set):
TELEGRAM_LOCAL_API_URL=http://localhost:8081
#
# NOTE: Large file support now works with forwarded videos if Telegram allows it.
# Users should send videos directly (not forwarded) for best compatibility.

# Email Configuration (Gmail API OAuth2 - for password reset emails)
# Also used for Google OAuth Login (Continue with Google)
# Get OAuth2 credentials from Google Cloud Console:
# 1. Create project at: https://console.cloud.google.com
# 2. Enable Gmail API
# 3. Create OAuth2 credentials (Web application)
# 4. Add Authorized Redirect URIs:
#    - https://your-backend.railway.app/api/auth/google/callback
#    - http://localhost:5000/api/auth/google/callback (for development)
# 5. Use OAuth Playground to get refresh token: https://developers.google.com/oauthplayground
GMAIL_CLIENT_ID=your-google-client-id
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_USER=your-email@gmail.com
# Note: Leave GMAIL_* empty to disable email (development mode will return token in response)

# System Defaults (Optional - have defaults in code)
DEFAULT_EARNINGS_PER_VIEW=0.001
MIN_WITHDRAWAL_AMOUNT=100
MAX_VIEWS_PER_IP_PER_HOUR=10
MIN_WATCH_SECONDS=5
MAX_UPLOAD_SIZE_BYTES=1073741824

# Thumbnail
# Default thumbnail shown when video has no thumbnail (optional)
DEFAULT_THUMBNAIL_URL=https://pub-11c2b603246a4f87b285e337ee6ad598.r2.dev/default-thumb.jpg
